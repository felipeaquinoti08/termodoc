<div class="termodocs-tab p-2">
    {% if can_create %}
        <div class="mb-3">
            {% if has_templates %}
                <a href="{{ generate_url }}" class="btn btn-primary btn-sm">
                    <i class="ti ti-file-plus"></i> {{ __('Gerar documento', 'termodocs') }}
                </a>
            {% else %}
                <span class="text-muted">{{ __('Nenhum modelo de documento configurado para este tipo de ativo ainda.', 'termodocs') }}</span>
            {% endif %}
        </div>
    {% endif %}

    {% if documents is empty %}
        <p class="text-muted">{{ __('Nenhum documento gerado para este ativo ainda.', 'termodocs') }}</p>
    {% else %}
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>{{ __('Name') }}</th>
                    <th>{{ _n('Status', 'Statuses', 1) }}</th>
                    <th>{{ __('Data de geração', 'termodocs') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for doc in documents %}
                    <tr>
                        <td><a href="{{ doc.view_url }}">{{ doc.name }}</a></td>
                        <td><span class="badge {{ doc.status_class }}">{{ doc.status_label }}</span></td>
                        <td>{{ doc.date_generated }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
</div>
