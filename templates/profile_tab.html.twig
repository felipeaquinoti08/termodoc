{% import 'components/form/basic_inputs_macros.html.twig' as inputs %}
{% import 'components/form/fields_macros.html.twig' as fields %}

<div class="asset">
    {% if can_edit %}
        <form method="post" action="{{ 'Profile'|itemtype_form_path }}" data-track-changes="true">
            <input type="hidden" name="id" value="{{ item.getID() }}">
            {{ fields.csrfField() }}
    {% endif %}
            <div>
                <div class="card-body p-0">
                    {% do item.displayRightsChoiceMatrix(rights, {
                        canedit: can_edit,
                        title: __('Termodocs')
                    }) %}
                </div>
    {% if can_edit %}
                <div class="card-body mx-n2 border-top d-flex flex-row-reverse align-items-start flex-wrap">
                    {{ inputs.submit('update', _x('button', 'Save'), 1, {
                        class: 'btn btn-primary',
                        icon: 'ti ti-device-floppy'
                    }) }}
                </div>
    {% endif %}
            </div>
    {% if can_edit %}
        </form>
    {% endif %}
</div>
