{% import 'components/form/basic_inputs_macros.html.twig' as inputs %}
{% import 'components/form/fields_macros.html.twig' as fields %}

<div class="termodocs-document card">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start flex-wrap mb-3">
            <div>
                <h3>{{ item.fields.name }}</h3>
                <span class="badge {{ status_class }}">{{ status_label }}</span>
            </div>
            <div class="d-flex gap-2">
                {% if item.fields.pdf_document_id %}
                    <a class="btn btn-outline-secondary btn-sm"
                       href="{{ config('root_doc') }}/plugins/termodocs/front/document.send.php?documents_id={{ item.getID() }}">
                        <i class="ti ti-download"></i> {{ __('Download PDF') }}
                    </a>
                {% endif %}
                {% if can_accept %}
                    <a class="btn btn-primary btn-sm"
                       href="{{ config('root_doc') }}/plugins/termodocs/front/acceptance.php?documents_id={{ item.getID() }}">
                        <i class="ti ti-signature"></i> {{ __('Revisar e assinar', 'termodocs') }}
                    </a>
                {% endif %}
                {% if can_choose_signature %}
                    <form method="post" action="{{ config('root_doc') }}/plugins/termodocs/front/document.form.php" class="d-flex gap-2 align-items-center">
                        <input type="hidden" name="id" value="{{ item.getID() }}">
                        {{ fields.csrfField() }}
                        <select name="signature_provider" class="form-select form-select-sm" style="width:auto">
                            {% for key, label in available_providers %}
                                <option value="{{ key }}"{{ key == current_provider_key ? ' selected' : '' }}>{{ label }}</option>
                            {% endfor %}
                        </select>
                        <button type="submit" name="send_signature" class="btn btn-primary btn-sm">
                            <i class="ti ti-send"></i> {{ __('Enviar para assinatura', 'termodocs') }}
                        </button>
                    </form>
                {% endif %}
            </div>
        </div>

        <dl class="row">
            <dt class="col-3">{{ recipient_role_label }}</dt>
            <dd class="col-9">{{ recipient.getFriendlyName() }}</dd>
            <dt class="col-3">{{ deliverer_role_label }}</dt>
            <dd class="col-9">{{ deliverer.getFriendlyName() }}</dd>
            <dt class="col-3">{{ __('Data de geração', 'termodocs') }}</dt>
            <dd class="col-9">{{ item.fields.date_generated }}</dd>
            {% if item.fields.date_finalized %}
                <dt class="col-3">{{ __('Data de finalização', 'termodocs') }}</dt>
                <dd class="col-9">{{ item.fields.date_finalized }}</dd>
            {% endif %}
            <dt class="col-3">{{ __('Assinatura de', 'termodocs') }} {{ recipient_role_label }}</dt>
            <dd class="col-9">
                {% if recipient_signed %}
                    <span class="badge bg-green-lt"><i class="ti ti-check"></i> {{ __('Assinado', 'termodocs') }}</span>
                {% else %}
                    <span class="badge bg-orange-lt">{{ __('Pendente', 'termodocs') }}</span>
                {% endif %}
            </dd>
            <dt class="col-3">{{ __('Assinatura de', 'termodocs') }} {{ deliverer_role_label }}</dt>
            <dd class="col-9">
                {% if deliverer_signed %}
                    <span class="badge bg-green-lt"><i class="ti ti-check"></i> {{ __('Assinado', 'termodocs') }}</span>
                {% else %}
                    <span class="badge bg-orange-lt">{{ __('Pendente', 'termodocs') }}</span>
                {% endif %}
            </dd>
        </dl>
        {% if waiting_other_party %}
            <div class="alert alert-info">{{ __('Você já assinou; aguardando a assinatura da outra parte.', 'termodocs') }}</div>
        {% endif %}
        {% if waiting_externally %}
            <div class="alert alert-info">{{ __('A assinatura deste documento é feita fora do GLPI, através de', 'termodocs') }} {{ signature_provider_label }}. {{ __('Verifique seu e-mail para o link de assinatura.', 'termodocs') }}</div>
        {% endif %}

        {% if items is not empty %}
            <h5>{{ _n('Ativo vinculado', 'Ativos vinculados', 2, 'termodocs') }}</h5>
        {% endif %}
        {% if is_admin %}
            <form method="post" action="{{ config('root_doc') }}/plugins/termodocs/front/document.form.php">
                <input type="hidden" name="id" value="{{ item.getID() }}">
                {{ fields.csrfField() }}
                {% if items is not empty %}
                    <table class="table table-sm w-auto mb-2">
                        <tbody>
                            {% for linked in items %}
                                <tr>
                                    <td>{{ linked.display_name }}</td>
                                    <td>
                                        <select name="condition[{{ linked.id }}]" class="form-select form-select-sm">
                                            <option value="">{{ __('Não avaliado', 'termodocs') }}</option>
                                            {% for value, label in condition_options %}
                                                <option value="{{ value }}"{{ linked.condition == value ? ' selected' : '' }}>{{ label }}</option>
                                            {% endfor %}
                                        </select>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% endif %}

                <h5>{{ __('Acessórios (não inventariados)', 'termodocs') }}</h5>
                <div class="mb-2 d-flex flex-wrap gap-3">
                    {% for value, label in accessory_options %}
                        <label class="form-check">
                            <input type="checkbox" class="form-check-input" name="accessories[]" value="{{ value }}"
                                {{ value in checked_accessories ? 'checked' : '' }}>
                            <span class="form-check-label">{{ label }}</span>
                        </label>
                    {% endfor %}
                </div>

                <div class="mb-2" style="max-width:500px">
                    <label class="form-label">{{ __('Observações', 'termodocs') }}</label>
                    <textarea name="notes" class="form-control" rows="3">{{ item.fields.notes }}</textarea>
                </div>
                <button type="submit" name="save_notes" class="btn btn-outline-primary btn-sm">
                    <i class="ti ti-device-floppy"></i> {{ __('Salvar observações', 'termodocs') }}
                </button>
                <div class="form-text">{{ __('Ao salvar, o PDF é atualizado com a condição de cada equipamento, os acessórios e as observações.', 'termodocs') }}</div>
            </form>
        {% else %}
            {% if items is not empty %}
                <ul>
                    {% for linked in items %}
                        <li>
                            {{ linked.display_name }}
                            {% if linked.condition_label %}
                                <span class="badge {{ linked.condition_class }}">{{ linked.condition_label }}</span>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}

            <h5>{{ __('Acessórios (não inventariados)', 'termodocs') }}</h5>
            <ul>
                {% for value, label in accessory_options %}
                    <li>
                        {{ label }}
                        {% if value in checked_accessories %}
                            <span class="badge bg-green-lt">{{ accessory_done_label }}</span>
                        {% else %}
                            <span class="badge bg-secondary-lt">{{ __('Não informado', 'termodocs') }}</span>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>

            {% if item.fields.notes %}
                <p class="text-muted">{{ __('Observações', 'termodocs') }}: {{ item.fields.notes }}</p>
            {% endif %}
        {% endif %}

        <h5>{{ __('Pré-visualização do conteúdo', 'termodocs') }}</h5>
        <iframe class="termodocs-preview-frame" style="width:100%;min-height:600px;border:1px solid #dee2e6"
            srcdoc="{{ ('<style>' ~ item.fields.theme_css_snapshot ~ '</style>' ~ item.composeSignedHtml(conditions_preview_html))|escape('html_attr') }}">
        </iframe>

        {% if is_admin and item.isExternallySigned() and item.fields.external_payload %}
            <details class="mt-3">
                <summary class="text-muted" style="cursor:pointer">{{ __('Diagnóstico (Assinei.digital)', 'termodocs') }}</summary>
                <pre class="mt-1 p-2" style="max-height:300px;overflow:auto;background:#f8f9fa;border:1px solid #dee2e6;white-space:pre-wrap;word-break:break-word;">{{ item.fields.external_payload }}</pre>
            </details>
        {% endif %}
    </div>
</div>
